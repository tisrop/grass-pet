{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "阿飘道长桌宠",
  "mainBinaryName": "apiao-daozhang-desktop-pet",
  "version": "1.1.0",
  "identifier": "com.grass.tuanzi",
  "build": {
    "beforeDevCommand": "pnpm run vue:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run vue:build",
    "frontendDist": "../dist-vue"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "阿飘道长桌宠",
        "url": "index.html",
        "width": 240,
        "height": 320,
        "minWidth": 156,
        "minHeight": 236,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "dashboard",
        "title": "阿飘道长的道观",
        "url": "dashboard.html",
        "width": 420,
        "height": 620,
        "minWidth": 380,
        "minHeight": 520,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "reminder",
        "title": "提醒",
        "url": "reminder.html",
        "width": 420,
        "height": 480,
        "minWidth": 360,
        "minHeight": 360,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "context-menu",
        "title": "桌宠菜单",
        "url": "context-menu.html",
        "width": 154,
        "height": 158,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "治愈系跨平台桌面宠物",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MzZCRDBBOTkxMUZGQwpSV1Q4SDVHcDBHdVRCVzNxeU10elR4c3ppUDRuUG1tQ3NWVnpxSXNNSWg3SU40eGNndUEwZmhReQo=",
      "endpoints": [
        "https://github.com/tisrop/grass-pet/releases/latest/download/latest.json"
      ]
    }
  }
}
